FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
# Minimal apt base — only what mise and git need at the OS layer.
# Everything else (node, python, go, rg, fd, jq, fzf, gh, nvim, pwsh, ...)
# is installed via mise into the SHARED volume (/opt/mise-shared) at build
# warm-up / first shell start.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    git \
    openssh-client \
    bash \
    less \
    procps \
    jq \
    wget \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/bin/sudo /usr/bin/su 2>/dev/null || true

# Install mise (binary only; toolchains are installed lazily into the shared volume)
RUN curl -fsSL https://mise.run | sh \
    && mv /root/.local/bin/mise /usr/local/bin/mise \
    && chmod +x /usr/local/bin/mise \
    && mise --version

# Create non-root user (no sudo, no extra groups).
# Login shell = sandbox-pwsh launcher (resolves mise's pwsh; bash fallback).
RUN useradd -m -s /usr/local/bin/sandbox-pwsh -u 1000 dev \
    && mkdir -p /work /etc/sandbox/dotfiles \
    && chown dev:dev /work \
    && chmod 755 /work

# Default mise manifest and dotfiles (also shipped as /etc/sandbox/* inside VM build script)
COPY files/mise.toml /etc/sandbox/mise.toml
COPY files/dotfiles/ /etc/sandbox/dotfiles/
COPY files/carapace/ /etc/carapace/
COPY files/fenrir /usr/local/bin/fenrir
COPY files/gleiphnir /usr/local/bin/gleiphnir
COPY files/start-pwsh.sh /usr/local/bin/sandbox-pwsh
COPY entrypoint.sh /usr/local/bin/sandbox-entrypoint.sh
RUN chmod +x /usr/local/bin/sandbox-pwsh /usr/local/bin/sandbox-entrypoint.sh /usr/local/bin/fenrir /usr/local/bin/gleiphnir \
    && ln -sfn /usr/local/bin/fenrir /usr/local/bin/fen \
    && ln -sfn /usr/local/bin/gleiphnir /usr/local/bin/gle

USER dev
WORKDIR /work
ENV SHELL=/usr/local/bin/sandbox-pwsh

ENTRYPOINT ["/usr/local/bin/sandbox-entrypoint.sh"]
CMD ["/usr/local/bin/sandbox-pwsh"]
