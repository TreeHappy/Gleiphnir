#!/usr/bin/env bash
# fenrir — Fenrir sandbox CLI (in-container) — YOLO-safe
# Alias: fen
# In-container yolo mode: only read/inspect, no host-modifying surface.
# Delegates to gdu for volume inspection and yazi (yasi) for browsing,
# otherwise proxies to the underlying sandbox-* tools when safe.
# Host privileged ops (firewall, user add/remove, secrets set, policy allow/deny)
# must use gleiphnir on host: gle policy|user|secrets|fw
# All volume/size logic uses gdu when available; falls back to du/bc.
set -euo pipefail

# Resolve alias: if invoked as `fen`, behave identical to `fenrir`
BIN_NAME="$(basename "$0")"

# ── helpers ────────────────────────────────────────────────────────────
die() { echo "error: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

MISE_DATA_DIR="${MISE_DATA_DIR:-/opt/mise-shared/data}"
USER_DATA_DIR="${HOME}/.local/share/mise/data"
SHARED_INSTALLS="${MISE_DATA_DIR}/installs"
USER_INSTALLS="${USER_DATA_DIR}/installs"

# ── yolo detection: inside podman container vs VM/host ────────────────
# Only yolo when BOTH a container marker AND the Gleiphnir container identity
# (dev user + /etc/sandbox/mise.toml baked). Prevents false positive on
# host Codespaces/devcontainers which also have /.dockerenv but not Gleiphnir.
is_container() {
  local has_marker=0
  [ -f /.dockerenv ] && has_marker=1
  [ -f /run/.containerenv ] && has_marker=1
  [ -n "${container:-}" ] && has_marker=1
  if [ "$has_marker" = "1" ] && [ "$(id -un 2>/dev/null)" = "dev" ] && [ -f /etc/sandbox/mise.toml ]; then
    return 0
  fi
  # also allow explicit opt-in for tests: FENRIR_YOLO=1
  [ "${FENRIR_YOLO:-}" = "1" ] && return 0
  return 1
}
IS_CONTAINER=0
if is_container; then IS_CONTAINER=1; fi

deny_inside() {
  echo "error: '$*' denied inside container (yolo mode). Use gleiphnir on host:" >&2
  echo "  gle $*   # or: mise run $*  |  ssh admin@192.168.100.10 \"sudo sandbox-${1%% *} ...\"" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
fenrir (fen) — Fenrir sandbox CLI (in-container, yolo-safe)

Usage (inside container — yolo, read-only):
  fenrir tools list                        List all installed tools (shared + personal)
  fenrir tools info <tool>                 Show details for a specific tool
  fenrir tools clean <tool>                Remove a personal tool install
  fenrir tools clean:all                   Remove all personal tool installs
  fenrir tools volumes [--gdu]             Show volume mount info and disk usage (via gdu)
  fenrir tools browse [path]               Browse tool volumes with yazi (yasi)
  fenrir tools search QUERY [--source npm|pypi|crates|go|github|exa]  Proxy-aware search
  fenrir browse [path]                     Browse filesystem with yazi (yasi)
  fenrir volumes                           Alias for `fenrir tools volumes`
  fenrir sbom container|tools [--format] [--output]  Generate SBOM (container/tools only)
  fenrir journal [flags]                   Query the agent audit journal (read-only)
  fenrir policy ls [--wide] [--json] [--sandbox NAME]  List policy (read-only)
  fenrir policy check network <host|url> [--sandbox NAME]  Test if host would be allowed
  fenrir --help                            Show this help

Privileged ops denied inside (yolo): use gleiphnir on host
  gle policy init|allow|deny|rm|reset|preset  # was fen policy allow/deny
  gle user add|remove|list
  gle secrets sync|list|status  # was fen secrets set/remove/export/rotate
  gle fw ... / gle firewall  # was fen firewall
  gle policy preset list  # etc.

Delegation:
  - volumes → gdu (go disk usage) when available, else du
  - browse  → yazi (yasi) when available, else ls
  - other tools subcommands → sandbox-tools (if present) or built-in fallback
  - sbom container/tools → sandbox-sbom; sbom vm/all denied inside
  - journal → sandbox-journal (read-only)
  - policy ls/check → sandbox-policy (read-only)

Aliases:
  fen  → fenrir

Examples (inside):
  fenrir tools list
  fenrir tools volumes           # gdu /opt/mise-shared
  fenrir tools search "http client" --source npm
  fenrir browse /work            # yazi
  fenrir policy ls --wide
  fenrir policy check network registry.npmjs.org
  fenrir sbom container --format cyclonedx
  fenrir journal --last 50 --grep git

Examples (host, privileged):
  gle policy allow network registry.npmjs.org
  gle user add USER=alice KEY=~/.ssh/id_ed25519.pub
  gle secrets sync

USAGE
}

# ── gdu / yazi helpers ───────────────────────────────────────────────
run_gdu() {
  local target="${1:-/opt/mise-shared}"
  if have gdu; then
    # gdu: interactive TUI if tty, else summary
    if [ -t 1 ]; then
      exec gdu "$target"
    else
      gdu --non-interactive --summarize "$target" 2>/dev/null || gdu "$target" || du -sh "$target"
    fi
  elif have gdu-go; then
    if [ -t 1 ]; then exec gdu-go "$target"; else du -sh "$target"; fi
  else
    echo "[fenrir] gdu not found — falling back to du. Install with: mise use gdu@latest" >&2
    du -sh "$target" 2>/dev/null || du -sb "$target" 2>/dev/null | awk '{print $1 " B  " $2}'
  fi
}

run_yazi() {
  local target="${1:-.}"
  if have yazi; then
    exec yazi "$target"
  elif have yasi; then
    exec yasi "$target"
  else
    echo "[fenrir] yazi (yasi) not found — falling back to ls. Install with: mise use yazi@latest" >&2
    ls -lah "$target"
  fi
}

# ── fallback implementations (when sandbox-tools binary missing) ──────
human_size() {
  local bytes="$1"
  if have numfmt; then
    numfmt --to=iec-i --suffix=B "$bytes" 2>/dev/null || echo "${bytes} B"
    return
  fi
  if   [ "$bytes" -ge 1073741824 ]; then printf "%.1f GB" "$(echo "scale=1; $bytes/1073741824" | bc 2>/dev/null || echo "0")"
  elif [ "$bytes" -ge 1048576 ];    then printf "%.1f MB" "$(echo "scale=1; $bytes/1048576" | bc 2>/dev/null || echo "0")"
  elif [ "$bytes" -ge 1024 ];       then printf "%.1f KB" "$(echo "scale=1; $bytes/1024" | bc 2>/dev/null || echo "0")"
  else printf "%d B" "$bytes"
  fi
}
dir_size_bytes() {
  local dir="$1"
  [ -d "$dir" ] && du -sb "$dir" 2>/dev/null | awk '{print $1}' || echo "0"
}

delegate_or_fallback() {
  # Try to delegate to underlying sandbox-* binary; if missing, run fallback
  local bin="$1"; shift
  if have "$bin"; then
    exec "$bin" "$@"
  elif [ -x "/usr/local/bin/$bin" ]; then
    exec "/usr/local/bin/$bin" "$@"
  else
    return 1
  fi
}

# ── tools subcommands (gdu/yazi aware) ───────────────────────────────
cmd_tools() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)
      if delegate_or_fallback sandbox-tools list; then return; fi
      # Fallback list using du
      echo "=== Shared tools (/opt/mise-shared) ==="
      if [ -d "$SHARED_INSTALLS" ]; then
        for tool_dir in "$SHARED_INSTALLS"/*/; do
          [ -d "$tool_dir" ] || continue
          local name; name="$(basename "$tool_dir")"
          for ver_dir in "$tool_dir"*/; do
            [ -d "$ver_dir" ] || continue
            local ver; ver="$(basename "$ver_dir")"
            printf "  %-24s %-12s %s\n" "$name" "$ver" "$(human_size "$(dir_size_bytes "$ver_dir")")"
          done
        done
      else
        echo "  (no shared tools installed)"
      fi
      echo ""
      echo "=== Personal tools (~/.local/share/mise) ==="
      if [ -d "$USER_INSTALLS" ]; then
        for tool_dir in "$USER_INSTALLS"/*/; do
          [ -d "$tool_dir" ] || continue
          local name; name="$(basename "$tool_dir")"
          for ver_dir in "$tool_dir"*/; do
            [ -d "$ver_dir" ] || continue
            local ver; ver="$(basename "$ver_dir")"
            printf "  %-24s %-12s %s\n" "$name" "$ver" "$(human_size "$(dir_size_bytes "$ver_dir")")"
          done
        done
      else
        echo "  (no personal tools installed)"
      fi
      ;;
    info)
      if delegate_or_fallback sandbox-tools info "$@"; then return; fi
      local tool="${1:-}"; [ -n "$tool" ] || die "fenrir tools info requires a tool name"
      echo "Tool: $tool"
      [ -d "$SHARED_INSTALLS/$tool" ] && echo "  shared: $SHARED_INSTALLS/$tool" || echo "  shared: not found"
      [ -d "$USER_INSTALLS/$tool" ] && echo "  personal: $USER_INSTALLS/$tool" || echo "  personal: not found"
      ;;
    clean)
      if delegate_or_fallback sandbox-tools clean "$@"; then return; fi
      local tool="${1:-}"; [ -n "$tool" ] || die "fenrir tools clean requires a tool name"
      if [ -d "$USER_INSTALLS/$tool" ]; then rm -rf "$USER_INSTALLS/$tool" && echo "Removed $tool"; else echo "No personal install for $tool"; fi
      ;;
    clean:all)
      if delegate_or_fallback sandbox-tools "clean:all"; then return; fi
      [ -d "$USER_INSTALLS" ] && rm -rf "$USER_INSTALLS" && echo "Removed all personal tools" || echo "No personal tools"
      ;;
    volumes)
      # Prefer gdu; handle --gdu flag
      local use_gdu=auto
      local gdu_target=""
      for a in "$@"; do
        case "$a" in --gdu) use_gdu=force ;; --no-gdu) use_gdu=none ;; *) gdu_target="$a" ;; esac
      done
      if [ "$use_gdu" = "force" ] && ! have gdu; then die "gdu not installed (mise use gdu@latest)"; fi
      if [ "$use_gdu" != "none" ] && have gdu; then
        echo "=== Volume mounts (via gdu) ==="
        echo ""
        echo "--- Shared tools (/opt/mise-shared) ---"
        run_gdu "${gdu_target:-/opt/mise-shared}"
        echo ""
        echo "--- Home ($HOME) ---"
        gdu --non-interactive --summarize "$HOME" 2>/dev/null || du -sh "$HOME" 2>/dev/null || true
        echo ""
        echo "--- Workspace (/work) ---"
        gdu --non-interactive --summarize /work 2>/dev/null || du -sh /work 2>/dev/null || true
      else
        if delegate_or_fallback sandbox-tools volumes; then return; fi
        # Fallback handled by delegate
      fi
      ;;
    browse)
      run_yazi "${1:-/opt/mise-shared}"
      ;;
    search)
      if delegate_or_fallback sandbox-tools search "$@"; then return; fi
      die "sandbox-tools search not found (requires sandbox-tools with search)"
      ;;
    ""|-h|--help|help)
      cat <<'HELP'
fenrir tools — inspect and manage mise tool installs (via gdu/yazi)

Usage:
  fenrir tools list
  fenrir tools info <tool>
  fenrir tools clean <tool>
  fenrir tools clean:all
  fenrir tools volumes [--gdu|--no-gdu]   # gdu for disk analysis
  fenrir tools browse [path]              # yazi (yasi) file manager
  fenrir tools search QUERY [--source npm|pypi|crates|go|github|exa] # proxy-aware search
HELP
      ;;
    *) die "unknown fenrir tools subcommand: $sub (see fenrir tools --help)" ;;
  esac
}

# ── dispatch ─────────────────────────────────────────────────────────
# Top-level aliases
case "${1:-}" in
  -h|--help|help|"")
    # If no args or help, show usage
    if [ $# -eq 0 ]; then usage; exit 0; fi
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then usage; exit 0; fi
    ;;
esac

# Handle top-level `volumes` alias and `browse` alias
if [ "${1:-}" = "volumes" ]; then
  shift
  cmd_tools volumes "$@"
  exit $?
fi
if [ "${1:-}" = "browse" ]; then
  shift
  run_yazi "${1:-.}"
  exit $?
fi

CMD="${1:-}"; shift || true
case "$CMD" in
  tools)
    cmd_tools "$@"
    ;;
  user)
    if [ "$IS_CONTAINER" = "1" ]; then deny_inside "user $*"; fi
    delegate_or_fallback sandbox-user "$@" || die "sandbox-user not found (VM only: gle user …)"
    ;;
  secrets)
    if [ "$IS_CONTAINER" = "1" ]; then deny_inside "secrets $*"; fi
    delegate_or_fallback sandbox-secrets "$@" || die "sandbox-secrets not found (use gle secrets on host)"
    ;;
  sbom)
    # yolo: only container|tools allowed inside
    if [ "$IS_CONTAINER" = "1" ]; then
      case "${1:-}" in
        container|tools) delegate_or_fallback sandbox-sbom "$@" || die "sandbox-sbom not found" ;;
        vm|all|"") deny_inside "sbom $* (only 'sbom container|tools' allowed inside)" ;;
        *) die "sbom inside only: sbom container|tools (denied: sbom $*)" ;;
      esac
    else
      delegate_or_fallback sandbox-sbom "$@" || die "sandbox-sbom not found"
    fi
    ;;
  journal)
    # read-only, allowed inside
    delegate_or_fallback sandbox-journal "$@" || die "sandbox-journal not found"
    ;;
  proxy)
    if [ "$IS_CONTAINER" = "1" ]; then deny_inside "proxy $*"; fi
    delegate_or_fallback sandbox-proxy "$@" || die "sandbox-proxy not found (host only)"
    ;;
  firewall)
    if [ "$IS_CONTAINER" = "1" ]; then deny_inside "firewall $*"; fi
    delegate_or_fallback sandbox-firewall "$@" || die "sandbox-firewall not found (use gle policy on host)"
    ;;
  policy)
    sub="${1:-}"
    case "$sub" in
      ls|list|show|status|check)
        # read-only allowed inside
        delegate_or_fallback sandbox-policy "$@" || die "sandbox-policy not found"
        ;;
      init|allow|deny|rm|remove|delete|reset|preset|dump|"")
        if [ "$IS_CONTAINER" = "1" ]; then deny_inside "policy $*"; fi
        delegate_or_fallback sandbox-policy "$@" || die "sandbox-policy not found (use gle policy on host)"
        ;;
      -h|--help|help)
        delegate_or_fallback sandbox-policy "$@" || die "sandbox-policy not found"
        ;;
      *)
        if [ "$IS_CONTAINER" = "1" ]; then deny_inside "policy $*"; fi
        delegate_or_fallback sandbox-policy "$@" || die "sandbox-policy not found"
        ;;
    esac
    ;;
  firewall:policy) # compat
    if [ "$IS_CONTAINER" = "1" ]; then deny_inside "policy $*"; fi
    delegate_or_fallback sandbox-policy "$@" || die "sandbox-policy not found"
    ;;
  -h|--help|help)
    usage; exit 0
    ;;
  *)
    echo "error: unknown fenrir command: $CMD" >&2
    usage
    exit 1
    ;;
esac
