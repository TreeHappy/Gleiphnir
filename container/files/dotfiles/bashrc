# /etc/sandbox/dotfiles/bashrc — sourced as ~/.bashrc inside the sandbox container
# Keep it minimal and deterministic. Env defaults (EDITOR, PAGER, ...) come from
# mise [env]; this file handles activation + integrations + aliases.

# mise activation — makes ALL manifest tools resolve in bash too
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
  # Ensure shims are on PATH even if activation is partial
  if [ -n "${MISE_DATA_DIR:-}" ] && [ -d "$MISE_DATA_DIR/shims" ]; then
    case ":$PATH:" in
      *":$MISE_DATA_DIR/shims:"*) ;;
      *) export PATH="$MISE_DATA_DIR/shims:$PATH" ;;
    esac
  fi
fi

# atuin — shell history (persisted via the per-user home volume)
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init bash)" 2>/dev/null || true
fi

# carapace — completions
if command -v carapace >/dev/null 2>&1; then
  source <(carapace _carapace) 2>/dev/null || true
fi

# Sensible defaults (fallbacks; mise env normally provides these)
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-nvim}"
export PAGER="${PAGER:-less}"
export LANG="${LANG:-C.UTF-8}"

# Prompt: dev@sandbox:/work$
if [ -n "${BASH_VERSION:-}" ]; then
  PS1='\[\e[32m\]dev@sandbox\[\e[0m\]:\[\e[34m\]\w\[\e[0m\]\$ '
fi

# Helpful aliases
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -n 20'
alias md='leaf'          # markdown reader

# ── audit journal: log every command after execution ────────────────────────
# Writes JSONL entries to /var/log/sandbox/journal-<user>.jsonl
# Each entry: timestamp, event, user, session_id, command, cwd, exit_code, duration_ms
__sandbox_journal_log() {
  local exit_code=$?
  local cmd="$__sandbox_journal_cmd"
  local start="$__sandbox_journal_start"
  [ -z "$cmd" ] && return
  # Skip journal internals and PROMPT_COMMAND
  [[ "$cmd" == __sandbox_* ]] && return
  [[ "$cmd" == __sandbox_journal_log ]] && return

  local end
  end=$(date +%s%N 2>/dev/null || echo 0)
  local duration_ms=0
  if [ -n "$start" ] && [ "$end" != "0" ] && [ -n "$end" ]; then
    duration_ms=$(( (end - start) / 1000000 ))
  fi

  local cwd
  cwd="$(pwd)"
  local journal_file="/var/log/sandbox/journal-${USER_NAME:-$(id -un)}.jsonl"

  printf '{"timestamp":"%s","event":"command","user":"%s","session_id":"%s","command":"%s","cwd":"%s","exit_code":%d,"duration_ms":%d}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)" \
    "${USER_NAME:-$(id -un)}" \
    "${SESSION_ID:-$$}" \
    "$(printf '%s' "$cmd" | sed 's/\\/\\\\/g; s/"/\\"/g')" \
    "$cwd" \
    "$exit_code" \
    "$duration_ms" >> "$journal_file" 2>/dev/null || true
}

__sandbox_preexec() {
  __sandbox_journal_cmd="$BASH_COMMAND"
  __sandbox_journal_start=$(date +%s%N 2>/dev/null || date +%s)
}

# Only enable journal hooks if the log directory exists
if [ -d /var/log/sandbox ]; then
  trap '__sandbox_preexec' DEBUG
  PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;} __sandbox_journal_log"
fi

# Workspace reminder on first login
if [ -t 1 ] && [ ! -f /work/.sandbox-welcomed ]; then
  cat <<'WELCOME'
┌─ Gleiphnir sandbox ──────────────────────────────────────────────┐
│ Container rootfs: read-only & ephemeral.                          │
│ Persistent workspace:  /work   (→ /srv/sandbox/<you> on VM)       │
│ Persistent home:       ~  (caches, history, configs)               │
│ Shared tools volume:   /opt/mise-shared  (downloads once for all) │
│ Default shell: pwsh · Editor: nvim · Diff pager: delta            │
│ Tools via mise:        mise use node@lts / python@3.12 ...        │
│ Inspect tools:         sandbox-tools list / info / volumes        │
│ Audit journal:         sandbox-journal (query command history)     │
│ Personalize dotfiles:  mise run dotfiles:init (scaffold /work/dotfiles/) │
└───────────────────────────────────────────────────────────────────┘
WELCOME
  touch /work/.sandbox-welcomed 2>/dev/null || true
fi
