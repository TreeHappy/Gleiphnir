# Gleiphnir — sandbox configuration
# Override any of these by exporting before running `mise run` or editing this file.
# All values are loaded by mise (see [env] in mise.toml) and vm/scripts/lib.ps1.

# VM identity
VM_NAME=gleiphnir
VM_HOSTNAME=gleiphnir

# OS image (Ubuntu 26.04 LTS "Resolute Raccoon")
UBUNTU_RELEASE=resolute
UBUNTU_VERSION=26.04
UBUNTU_ARCH=amd64
# Cloud image URL (leave empty to auto-construct from release/arch)
# UBUNTU_IMAGE_URL=https://cloud-images.ubuntu.com/resolute/current/resolute-server-cloudimg-amd64.img
UBUNTU_IMAGE_URL=

# VM resources
VM_CPUS=4
VM_RAM_MB=4096
VM_DISK_SIZE=20G
DATA_DISK_SIZE=20G
QEMU_EXTRA_ARGS=
QEMU_BIN=qemu-system-x86_64
# auto|kvm|whpx|tcg — Windows hosts default to whpx; Linux to kvm when available
QEMU_ACCEL=auto
# QEMU monitor TCP port on native Windows hosts (unix socket is used on Linux)
QEMU_MONITOR_PORT=4444

# Networking
#  bridge  — TAP device bridged to host (isolated private bridge 192.168.100.0/24 by default)
#            Preserves real client IPs via DNAT (host forwards :2222 → VM :22).
#            Requires sudo for bridge/TAP creation. LINUX HOSTS ONLY.
#            Set PHYS_IF (e.g. eth0/enp0s3) to enslave a real NIC and put the VM directly on your LAN
#            (true LAN bridge — VM gets DHCP from LAN). Leave empty for private bridge.
#  user    — QEMU user-mode NAT with hostfwd (no host changes at all; used on Windows).
#            The VM cannot see real client IPs in this mode, so per-IP ufw filtering
#            inside the guest only applies in bridge mode.
NETWORK_MODE=bridge
BRIDGE_NAME=br-gleiphnir
TAP_NAME=tap-gleiphnir
BRIDGE_ADDR=192.168.100.1
BRIDGE_NETMASK=24
BRIDGE_NETWORK=192.168.100.0/24
VM_IP=192.168.100.10
VM_NETMASK=24
VM_GATEWAY=192.168.100.1
# VM_MAC is auto-generated if empty and persisted to vm/images/mac.addr
VM_MAC=
PHYS_IF=
HOST_SSH_FORWARD_PORT=2233

# Users
ADMIN_USER=admin
# Path to admin SSH public key (generated if missing)
ADMIN_SSH_KEY_PATH=~/.ssh/gleiphnir_admin.pub
ADMIN_SSH_PRIV_PATH=~/.ssh/gleiphnir_admin

# Container
CONTAINER_IMAGE=localhost/sandbox:latest
CONTAINER_NAME_PREFIX=sandbox

# Paths
IMAGES_DIR=vm/images
SEED_ISO=vm/images/seed.iso
SYSTEM_DISK=vm/images/system.qcow2
DATA_DISK=vm/images/data.qcow2

# ── Observability (Grafana LGTM) ────────────────────────────────────────────
# Enable optional observability stack: Grafana dashboards, session logging,
# HTTP traffic capture, and system metrics via the Grafana LGTM container.
# Requires podman on the host. Adds ~500 MB RAM overhead on host + ~90 MB in VM.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_LGTM_IMAGE=grafana/otel-lgtm:latest
# Grafana dashboard port on host
OBSERVABILITY_GRAFANA_PORT=3000
# OTLP receiver port (gRPC) on host — VM ships telemetry here
OBSERVABILITY_OTLP_PORT=4317
# Prometheus metrics port on host
OBSERVABILITY_PROM_PORT=9090
# Enable HTTP traffic capture via MITM proxy inside the VM
OBSERVABILITY_PROXY_ENABLED=true
# Enable session input (keystroke) logging
OBSERVABILITY_SESSION_LOGGING=true
