#!/usr/bin/env bash
# /usr/local/bin/sandbox-shell — login shell for sandbox users
# Spawns an ephemeral, read-only podman container with:
#   - RW persistent workspace at /work  (bind: /srv/sandbox/<user>)
#   - RW persistent per-user home volume (~/.cache, ~/.local, ~/.config)
#   - SHARED mise tool volume (sandbox-mise) — binaries download once for all users
# Workspace persists at /srv/sandbox/<user> on the VM's data disk.
set -euo pipefail

USER_NAME="$(id -un)"
WORKSPACE="/srv/sandbox/${USER_NAME}"
HOME_VOLUME="gleiphnir-home-${USER_NAME}"
MISE_VOLUME="sandbox-mise"
CONTAINER_IMAGE="${CONTAINER_IMAGE:-localhost/sandbox:latest}"

# If invoked as `sandbox-shell --help` or with explicit args, show usage
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<HELP
sandbox-shell — ephemeral sandbox container shell

Usage: sandbox-shell
  When set as a user's login shell, it automatically starts a podman container:
    - rootfs: read-only, cap-drop ALL, no-new-privileges
    - workspace: /srv/sandbox/<you> mounted at /work (RW, persistent)
    - home: named volume '$HOME_VOLUME' at /home/dev (RW, persists caches/history/configs)
    - tools: shared volume '$MISE_VOLUME' mounted at /opt/mise-shared (downloads once for all users)
    - default shell inside the container: pwsh (bash fallback until first install)

Config env:
  CONTAINER_IMAGE  container to run (default: localhost/sandbox:latest)
HELP
  exit 0
fi

# Ensure workspace exists
if [ ! -d "$WORKSPACE" ]; then
  mkdir -p "$WORKSPACE"
  chmod 700 "$WORKSPACE" 2>/dev/null || true
  # Seed with a README on first creation
  if [ ! -e "$WORKSPACE/README.md" ]; then
    cat > "$WORKSPACE/README.md" <<'EOF'
# Workspace

This directory is your persistent workspace. It is bind-mounted into every
sandbox container at `/work` with read-write access.

- Container rootfs is **read-only** and **ephemeral** (`--rm`); changes outside
  `/work` and your home directory do not persist.
- Your home (`~`) is a persistent per-user volume: `~/.cache`, `~/.local`,
  `~/.config` survive restarts (shell history via atuin included).
- Tools come from a **shared** mise volume (`/opt/mise-shared`): common
  toolchains are pre-installed and downloaded only once for everyone.
  Install extras with `mise use node@lts`, `mise use python@3.12`, ...
- Default shell is **pwsh**. `bash` is also available.
- No `sudo` inside the container. If you need system packages, ask the admin.

Happy hacking.
EOF
    chmod 644 "$WORKSPACE/README.md" 2>/dev/null || true
  fi
fi

# Ensure the shared mise volume and this user's home volume exist.
# (podman also auto-creates named volumes, but being explicit gives clearer errors.)
podman volume inspect "$MISE_VOLUME" >/dev/null 2>&1 || podman volume create "$MISE_VOLUME" >/dev/null
podman volume inspect "$HOME_VOLUME" >/dev/null 2>&1 || podman volume create "$HOME_VOLUME" >/dev/null

# Verify image exists
if ! podman image exists "$CONTAINER_IMAGE" 2>/dev/null; then
  echo "Sandbox image $CONTAINER_IMAGE not found. The VM is still provisioning — please wait ~1–2 minutes and reconnect." >&2
  echo "Admin can run: /usr/local/lib/sandbox/build-container.sh" >&2
  sleep 3
  if ! podman image exists "$CONTAINER_IMAGE" 2>/dev/null; then
    exit 1
  fi
fi

# Detect whether rootless podman works for this user
USE_ROOTLESS=1
if ! podman info >/dev/null 2>&1; then
  USE_ROOTLESS=0
fi

# Also check if keep-id is supported (podman >= 4)
HAS_KEEP_ID=0
if podman run --help 2>&1 | grep -q "userns"; then
  HAS_KEEP_ID=1
fi

# ── observability: check if enabled ─────────────────────────────────────────
OBS_ENABLED=0
if [ -f /var/lib/sandbox/observability-enabled ]; then
  OBS_ENABLED=1
fi

COMMON_ARGS=(
  --rm -it
  --read-only
  --tmpfs /tmp:rw,size=512m,mode=1777
  --tmpfs /run:rw,size=64m,mode=755
  --cap-drop ALL
  --security-opt no-new-privileges
  --pids-limit 512
  --memory 2g
  --cpus 2
  # persistent per-user home (replaces the old tmpfs home)
  -v "${HOME_VOLUME}:/home/dev:rw,U"
  # shared mise tool installs (download once, used by every sandbox user)
  -v "${MISE_VOLUME}:/opt/mise-shared:rw,U"
  -v "${WORKSPACE}:/work:rw"
  -w /work
  -e HOME=/home/dev
  -e USER=dev
  -e SHELL=/usr/local/bin/sandbox-pwsh
  -e MISE_DATA_DIR=/opt/mise-shared/data
  -e MISE_STATE_DIR=/opt/mise-shared/state
  -e MISE_CACHE_DIR=/opt/mise-shared/cache
  -e MISE_CONFIG_DIR=/work/.mise/config
  -e MISE_GLOBAL_CONFIG_FILE=/etc/sandbox/mise.toml
  --hostname "sandbox"
)

# Add observability proxy env vars if enabled
if [ "$OBS_ENABLED" = "1" ] && [ -f /var/lib/sandbox/observability-enabled ]; then
  # Check if mitmproxy is running
  if pgrep -x mitmdump >/dev/null 2>&1; then
    # Get the VM's IP so containers can reach the proxy (can't use 127.0.0.1 inside containers)
    _PROXY_HOST="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}')"
    _PROXY_HOST="${_PROXY_HOST:-$(hostname -I | awk '{print $1}')}"
    _PROXY_HOST="${_PROXY_HOST:-127.0.0.1}"
    COMMON_ARGS+=(
      -e http_proxy="http://${_PROXY_HOST}:8080"
      -e https_proxy="http://${_PROXY_HOST}:8080"
      -e HTTP_PROXY="http://${_PROXY_HOST}:8080"
      -e HTTPS_PROXY="http://${_PROXY_HOST}:8080"
      -e no_proxy="localhost,127.0.0.1,${_PROXY_HOST},10.0.2.2,192.168.100.0/24"
    )
  fi
fi

# ── launch container ─────────────────────────────────────────────────────────
if [ "$USE_ROOTLESS" = "1" ]; then
  # Rootless: preserve host UID for volume ownership via keep-id if available
  if [ "$HAS_KEEP_ID" = "1" ]; then
    PODMAN_CMD=(podman run "${COMMON_ARGS[@]}" --userns keep-id "$CONTAINER_IMAGE")
  else
    PODMAN_CMD=(podman run "${COMMON_ARGS[@]}" "$CONTAINER_IMAGE")
  fi
else
  # Rootful fallback via sudo (admin must have allowed this user in sudoers for podman)
  if command -v sudo >/dev/null 2>&1; then
    PODMAN_CMD=(sudo podman run "${COMMON_ARGS[@]}" "$CONTAINER_IMAGE")
  else
    echo "podman not usable for user $USER_NAME (neither rootless nor sudo podman available)" >&2
    exit 1
  fi
fi

# Wrap with session logger if observability is enabled
if [ "$OBS_ENABLED" = "1" ] && [ -x /usr/local/bin/sandbox-session-logger ]; then
  export SESSION_ID="$(date +%s)-$$"
  export USER_NAME
  exec /usr/local/bin/sandbox-session-logger "${PODMAN_CMD[@]}"
else
  exec "${PODMAN_CMD[@]}"
fi
