#!/usr/bin/env bash
# /usr/local/bin/sandbox-secrets — manage sandbox secrets on the VM (admin only)
# Secrets are stored at /var/lib/sandbox/secrets.env and injected as env vars
# into every sandbox container via sandbox-shell.
set -euo pipefail

SECRETS_FILE="/var/lib/sandbox/secrets.env"
SECRETS_DIR="/var/lib/sandbox"

usage() {
  cat <<'USAGE'
sandbox-secrets — manage sandbox secrets

Usage:
  sandbox-secrets list                Show secret key names (not values)
  sandbox-secrets set KEY=VALUE       Add or update a secret
  sandbox-secrets set KEY < file      Read value from file/stdin
  sandbox-secrets remove KEY          Delete a secret
  sandbox-secrets export              Dump all as KEY=VALUE (admin only)
  sandbox-secrets rotate KEY          Generate a random 32-char value for KEY

Requires root (run via sudo).
Secrets are injected as env vars into every sandbox container.
They do NOT persist to disk inside containers (read-only rootfs).
USAGE
}

die() { echo "error: $*" >&2; exit 1; }

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "sandbox-secrets must be run as root (use sudo)" >&2
    exit 1
  fi
}

ensure_secrets_file() {
  mkdir -p "$SECRETS_DIR"
  if [ ! -f "$SECRETS_FILE" ]; then
    touch "$SECRETS_FILE"
    chmod 600 "$SECRETS_FILE"
  fi
}

cmd_list() {
  ensure_secrets_file
  if [ ! -s "$SECRETS_FILE" ]; then
    echo "(no secrets configured)"
    return
  fi
  echo "=== configured secret keys ==="
  grep -v '^\s*#' "$SECRETS_FILE" | grep -v '^\s*$' | cut -d= -f1 | sed 's/^/  /'
  echo ""
  echo "Total: $(grep -v '^\s*#' "$SECRETS_FILE" | grep -v '^\s*$' | wc -l) secret(s)"
}

cmd_set() {
  require_root
  ensure_secrets_file
  local entry="$1"

  if [[ "$entry" == *"="* ]]; then
    local key="${entry%%=*}"
    local value="${entry#*=}"
  elif [ -n "$entry" ]; then
    local key="$entry"
    local value
    value="$(cat)"
  else
    die "set requires KEY=VALUE or KEY < file"
  fi

  [ -n "$key" ] || die "empty key"
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid key name: $key (must be [A-Za-z_][A-Za-z0-9_]*)"

  # Remove existing entry for this key, then append
  grep -v "^${key}=" "$SECRETS_FILE" > "${SECRETS_FILE}.tmp" 2>/dev/null || true
  echo "${key}=${value}" >> "${SECRETS_FILE}.tmp"
  mv "${SECRETS_FILE}.tmp" "$SECRETS_FILE"
  chmod 600 "$SECRETS_FILE"

  echo "Secret '$key' set."
}

cmd_remove() {
  require_root
  ensure_secrets_file
  local key="$1"
  [ -n "$key" ] || die "remove requires a key name"

  if ! grep -q "^${key}=" "$SECRETS_FILE" 2>/dev/null; then
    die "secret '$key' not found"
  fi

  grep -v "^${key}=" "$SECRETS_FILE" > "${SECRETS_FILE}.tmp"
  mv "${SECRETS_FILE}.tmp" "$SECRETS_FILE"
  chmod 600 "$SECRETS_FILE"

  echo "Secret '$key' removed."
}

cmd_export() {
  require_root
  ensure_secrets_file
  if [ ! -s "$SECRETS_FILE" ]; then
    echo "(no secrets configured)"
    return
  fi
  cat "$SECRETS_FILE"
}

cmd_rotate() {
  require_root
  local key="$1"
  [ -n "$key" ] || die "rotate requires a key name"
  local value
  value="$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32)"
  cmd_set "${key}=${value}"
  echo "Rotated '$key' → new value generated (32 chars)"
}

# ── main ───────────────────────────────────────────────────────────────────
case "${1:-}" in
  list)    cmd_list ;;
  set)     shift; [ $# -ge 1 ] || { usage; exit 1; }; cmd_set "$@" ;;
  remove)  shift; [ $# -ge 1 ] || { usage; exit 1; }; cmd_remove "$@" ;;
  export)  cmd_export ;;
  rotate)  shift; [ $# -ge 1 ] || { usage; exit 1; }; cmd_rotate "$@" ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
