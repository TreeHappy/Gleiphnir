#!/usr/sbin/nft -f
# /etc/nftables-sandbox.nft — managed by sandbox-firewall(1)
# Default policy: drop inbound except established/lo/icmp and SSH from @allow sets.

flush ruleset

table inet filter {
  set allow_ipv4 {
    type ipv4_addr
    flags interval
    elements = { 127.0.0.1 }
  }

  set allow_ipv6 {
    type ipv6_addr
    flags interval
  }

  set deny_ipv4 {
    type ipv4_addr
    flags interval
  }

  set deny_ipv6 {
    type ipv6_addr
    flags interval
  }

  chain input {
    type filter hook input priority 0; policy drop;

    # early deny — explicit blocklist wins
    ip saddr @deny_ipv4 drop
    ip6 saddr @deny_ipv6 drop

    ct state established,related accept
    iif "lo" accept

    # allow ICMP for diagnostics (rate-limited could be added)
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept

    # SSH from allowed sets (main entry point)
    tcp dport 22 ip saddr @allow_ipv4 accept
    tcp dport 22 ip6 saddr @allow_ipv6 accept

    # Optional: allow host bridge to always reach VM for management
    # tcp dport 22 ip saddr 192.168.100.1 accept
  }

  chain forward {
    type filter hook forward priority 0; policy accept;
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}
